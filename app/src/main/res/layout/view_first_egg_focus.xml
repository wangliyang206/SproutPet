<?xml version="1.0" encoding="utf-8"?>
<!--
  首蛋聚焦层（docs/14 §1.4 · 2026-10-17 拍板 · 2026-10-22 精简）：

  首蛋孵化期盖在场景之上的「一次性演出」—— 蛋 180dp 居中、场景压暗、
  MM:SS 大字倒计时 + 绝对时刻 + 三组动效（呼吸 / 轻晃 / 数字跳动，代码挂载）。

  ⚠️ **这一层只做一件事：让用户看着它孵化。**
  2026-10-22 用户拍板去掉「起个名字 / 专注陪伴 / 去看图鉴」三个按钮：
  ① 首蛋只有 1 分钟（§1.3），加速没有意义；
  ② 破壳才起名 —— 蛋期起名会让"看见它"和"填表单"抢同一个高光（§1.2 ④ 作废）；
  ③ 三个按钮把唯一的注意力从蛋上分走了。图鉴在抽屉里仍然可达，只是不再在这层出现。

  ⚠️ 只对首蛋启用：hasAnyPet == false 且存在孵化中蛋。
  破壳时由 SceneFragment 淡出移除；不做常驻（第 2 颗起回到角落 72dp 小蛋）。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/first_egg_focus"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#47101F14"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:id="@+id/first_egg_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/tv_first_egg_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/first_egg_hint"
            android:textColor="#FFFDE7"
            android:textSize="15sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <ImageView
            android:id="@+id/iv_first_egg"
            android:layout_width="@dimen/first_egg_size"
            android:layout_height="@dimen/first_egg_size"
            android:layout_marginTop="10dp"
            android:contentDescription="@string/first_egg_hint"
            android:src="@drawable/pet_egg_common" />

        <TextView
            android:id="@+id/tv_first_egg_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="01:00"
            android:textColor="#FFFDE7"
            android:textSize="34sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:fontFeatureSettings="tnum"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="8" />

        <TextView
            android:id="@+id/tv_first_egg_hatch_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#E8F0E4"
            android:textSize="11.5sp"
            tools:text="21:40 破壳 · 到点会提醒你" />

        <TextView
            android:id="@+id/tv_first_egg_crack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/first_egg_tap_hint"
            android:textColor="#C8E6C9"
            android:textSize="10.5sp"
            tools:text="想它了就敲敲它 · 它听得见" />
    </LinearLayout>
</FrameLayout>
