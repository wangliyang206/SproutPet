<?xml version="1.0" encoding="utf-8"?>
<!--
  桌宠技术验证面板（仅调试用途）。
  目的：在真机上逐一验证「全屏透明窗口 + 触摸穿透」的可行组合，
  找出能在各厂商 ROM 上稳定工作的方案，供 ADR-014 定案。

  设计取向：测试者只需「点按钮」，所有判断依据都自动写进日志文件，
  避免口述、截图这类容易失真的传递方式。

  本界面与正式业务无关，Phase 3 定案后可整体删除 debug 包。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="桌宠技术验证"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="@drawable/bg_card"
        android:padding="10dp"
        android:text="三步即可：\n1. 点下面任一模式的按钮（会自动退回桌面）\n2. 按提示操作两下，并点「人工观察」按钮记录结果\n3. 四个模式跑完后，点最下方「分享日志」发给我\n\n测完从通知栏点回来即可。"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <TextView
        android:id="@+id/permissionStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:padding="12dp"
        android:text="正在检查悬浮窗权限…"
        android:textSize="13sp"
        android:textColor="@color/text_primary" />

    <Button
        android:id="@+id/btnGrantPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="去开启悬浮窗权限" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="① 全屏渲染 · 全穿透"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全屏透明窗口设 FLAG_NOT_TOUCHABLE。预期：宠物可见但完全点不动，点空白能点到桌面图标。这是「纯展示」的极限。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnModeRenderOnly"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="启动 ①" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="② 全屏可点 · 会挡住桌面"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全屏透明窗口不加 NOT_TOUCHABLE。预期：宠物可拖可点，但整个桌面都点不动了 —— 用来证明「全屏可点」的代价。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnModeFullTouch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="启动 ②" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="③ 全屏渲染 + 独立触摸小窗"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="全屏穿透窗口只负责画；另开一个宠物大小的小窗专门收触摸。预期：宠物可拖可点，点空白能到桌面。架构文档 ADR-014 推演的首选方案。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnModeDualLayer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="启动 ③" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="④ 独立小窗（自渲染 + 自接收）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="每个宠物一个独立小窗，窗口外天然穿透。实现最简单，但窗口数 = 宠物数，多只时性能待测。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <Button
                android:id="@+id/btnModePetWindow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="启动 ④" />

            <Button
                android:id="@+id/btnStop"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="停止桌宠并清除窗口" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="@color/divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="人工观察（点一下即写入日志）"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="有些结果代码测不到（比如「桌面图标有没有被点开」），需要你看一眼后点一下下面的按钮。点错了再点另一个即可。"
                android:textSize="12sp"
                android:textColor="@color/text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnObserveDragOk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="拖动：跟手"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnObserveDragFail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="拖动：不动"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnObserveTapThroughOk"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:layout_weight="1"
                    android:text="空白：能点桌面"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnObserveTapThroughFail"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:text="空白：点不到"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="事件日志（本次会话）"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary" />

        <TextView
            android:id="@+id/btnClearLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:text="清空显示"
            android:textSize="13sp"
            android:textColor="@color/brand_primary" />

    </LinearLayout>

    <TextView
        android:id="@+id/logPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="日志文件：检查中…"
        android:textSize="11sp"
        android:textColor="@color/text_hint" />

    <ScrollView
        android:id="@+id/logScroll"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="@drawable/bg_card"
        android:padding="8dp">

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true" />

    </ScrollView>

    <Button
        android:id="@+id/btnShareLog"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="分享日志（发给我）" />

</LinearLayout>
