<?xml version="1.0" encoding="utf-8"?>
<!-- 全屏生活场景（倒置 IA · design-v2 屏①/屏⑩）：昼夜背景 + 宠物层 + 角落的蛋 + 右缘把手 -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ═══ 场景主内容 ═══ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- 昼夜背景（随真实时间切换，1.04 倍放大防视差露边） -->
        <ImageView
            android:id="@+id/iv_bg"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleX="1.04"
            android:scaleY="1.04"
            android:scaleType="centerCrop"
            android:contentDescription="@null" />

        <!-- 宠物站位层（动态添加，坐标取自 core ScenePetLayout.homeLayout） -->
        <FrameLayout
            android:id="@+id/pet_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 气泡 / 飘字特效层 -->
        <FrameLayout
            android:id="@+id/effect_layer"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- 顶部日签（唯一顶部 HUD，不挂货币） -->
        <TextView
            android:id="@+id/tv_day_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_chip_white"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp"
            android:textColor="@color/scene_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            tools:text="相伴第 1 天"
            xmlns:tools="http://schemas.android.com/tools" />

        <!-- 「院子里还有 N 只」（三层链条：拥有不限 ⊃ 家在册 6）。
             家站满 6 只后，新孵出的会留在院子 —— 没有这条角标，用户只会认为宠物丢了。
             与日签同列、紧贴其下，不压宠物站位（站位 y ∈ 0.62~0.78）。 -->
        <TextView
            android:id="@+id/tv_yard_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_marginStart="14dp"
            android:layout_marginTop="54dp"
            android:background="@drawable/bg_chip_white"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp"
            android:textColor="@color/scene_text"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- 角落的蛋（含标签；开箱 / 孵化 / 破壳的唯一直接入）。
             ⭐ 位置 = 右下角（design 01 屏「新蛋 · 轻点看看」），避让左下站位与底部托盘；
             marginBottom 随托盘状态动态调整（renderTray）。 -->
        <include
            android:id="@+id/scene_egg"
            layout="@layout/view_scene_egg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="90dp" />

        <!-- 右缘抽屉把手（唯一常驻 HUD） -->
        <LinearLayout
            android:id="@+id/drawer_handle"
            android:layout_width="@dimen/drawer_handle_width"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/bg_drawer_handle"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingVertical="13dp">

            <View
                android:layout_width="13dp"
                android:layout_height="2.4dp"
                android:background="@color/scene_sub" />
            <View
                android:layout_width="13dp"
                android:layout_height="2.4dp"
                android:layout_marginTop="5dp"
                android:background="@color/scene_sub" />
            <View
                android:layout_width="13dp"
                android:layout_height="2.4dp"
                android:layout_marginTop="5dp"
                android:background="@color/scene_sub" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/drawer_handle_label"
                android:textColor="@color/scene_hint"
                android:textSize="8.5sp" />
        </LinearLayout>

        <!-- 底部引导提示（新用户可见，有宠物后隐藏） -->
        <TextView
            android:id="@+id/tv_foot_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:paddingHorizontal="14dp"
            android:text="@string/scene_foot_hint"
            android:textColor="#9E263C23"
            android:textSize="11.5sp" />

        <!-- 互动托盘（design-v2 屏③ · K-2）：拖道具到宠物身上 = 喂食/玩耍/训练；有宠物时显示 -->
        <include
            android:id="@+id/interaction_tray"
            layout="@layout/view_interaction_tray"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="16dp"
            tools:visibility="gone"
            xmlns:tools="http://schemas.android.com/tools"
            tools:ignore="MissingId" />

        <!-- 首蛋聚焦层（docs/14 §1.4）：首蛋孵化期盖在场景之上，破壳后隐藏。
             ⚠️ `android:visibility="gone"` 是**运行时**默认值，不是可选项 ——
             这里曾经只写了 `tools:visibility="gone"`（只影响预览），运行时第一帧会把
             布局里的静态蛋（180dp + 01:00 + 三个按钮）当成真数据画出来，
             等真实状态到达再被淡出：用户看到的就是「一颗大蛋慢慢消失，只剩背景」。
             显隐**只能由数据驱动**（SceneFragment.renderFirstEggFocus），
             布局不给任何「假装有蛋」的初值。 -->
        <include
            android:id="@+id/first_egg_focus"
            layout="@layout/view_first_egg_focus"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:visibility="visible"
            xmlns:tools="http://schemas.android.com/tools" />

    </FrameLayout>

    <!-- ═══ 右缘抽屉内容（HomeDrawerFragment） ═══ -->
    <FrameLayout
        android:id="@+id/drawer_container"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_drawer_panel" />

</androidx.drawerlayout.widget.DrawerLayout>
