<?xml version="1.0" encoding="utf-8"?>
<!-- 强制起名弹窗（design-v2 屏⑥）：出生六维 + 必填昵称，不可取消 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_round"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/naming_title"
        android:textColor="@color/scene_text"
        android:textSize="16.5sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/iv_naming_pet"
        android:layout_width="88dp"
        android:layout_height="88dp"
        android:layout_marginTop="12dp"
        android:contentDescription="@null"
        tools:src="@drawable/pet_sprout_chicken_baby" />

    <!-- 出生六维（体力/力量/敏捷/智慧/魅力/亲密） -->
    <GridLayout
        android:id="@+id/grid_naming_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:columnCount="3" />

    <EditText
        android:id="@+id/et_naming_input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_kv_chip"
        android:gravity="center"
        android:hint="@string/naming_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="12"
        android:paddingVertical="12dp"
        android:textColor="@color/scene_text"
        android:textColorHint="@color/scene_hint"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/btn_naming_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_btn_primary"
        android:gravity="center"
        android:paddingVertical="13dp"
        android:text="@string/naming_confirm"
        android:textColor="@color/white"
        android:textSize="15.5sp"
        android:textStyle="bold" />
</LinearLayout>
