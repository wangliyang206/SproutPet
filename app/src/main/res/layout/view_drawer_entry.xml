<?xml version="1.0" encoding="utf-8"?>
<!-- 抽屉功能入口行（图标 + 标题/描述 + 箭头，见 design-v2 .mrow） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="12dp">

    <TextView
        android:id="@+id/tv_entry_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_kv_chip"
        android:gravity="center"
        android:textSize="17sp"
        tools:text="📖" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_entry_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/scene_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="图鉴" />
        <TextView
            android:id="@+id/tv_entry_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/scene_hint"
            android:textSize="10.5sp"
            tools:text="已收集 1 / 18" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="›"
        android:textColor="@color/scene_hint"
        android:textSize="17sp" />
</LinearLayout>
