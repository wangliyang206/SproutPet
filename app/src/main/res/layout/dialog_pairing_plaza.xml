<?xml version="1.0" encoding="utf-8"?>
<!--
  配对广场（design-v2 屏 24「找搭档」+ 屏 25「双光效汇合 · 后代预览」MVP 合并）

  守 L2 的硬要求（docs/00 §2.5 · §7.2）：
  - 七条前置**可见**（勾/叉动态显示，数字全部来自 PairingRules / 当前数据，UI 不自己算）
  - NPC 候选卡注明「同虫 / 跨虫」（跨虫 ×1.35 上漂是 BreedingRules 冻结的核心乐趣）
  - NPC 免确认立即配对（ADR-011）；配对语义 =「生育搭档」—— 你的宠不会被拿走
  - 配对中的显示冷却剩余与后代名额（S16：NPC 上限 3，真人 5）
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_round"
    android:orientation="vertical"
    android:paddingHorizontal="18dp"
    android:paddingTop="10dp"
    android:paddingBottom="20dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4.5dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_sheet_grip" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pairing_title"
            android:textColor="@color/scene_text"
            android:textSize="16.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_gold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_primary_dark"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="金币 12480" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_mode_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="@string/pairing_mode_hint"
        android:textColor="@color/scene_hint"
        android:textSize="11.5sp" />

    <!-- 我方宠选择 -->
    <LinearLayout
        android:id="@+id/card_mine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_btn_ghost"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/pairing_mine_label"
            android:textColor="@color/scene_hint"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/tv_mine"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="3"
            android:gravity="end"
            android:textColor="@color/scene_text"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="小豆芽 · Lv.26 · 成年" />
    </LinearLayout>

    <!-- 七条前置清单（动态文本） -->
    <TextView
        android:id="@+id/tv_checklist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/scene_sub"
        android:textSize="11.5sp"
        tools:text="✓ 双方成年 · ✓ 亲密度 ≥ 70 · ✓ 一公一母（NPC 取反）\n✓ 冷却已过 · ✓ 金币 3,000" />

    <!-- NPC 候选（代码动态生成 3 张卡） -->
    <LinearLayout
        android:id="@+id/ll_candidates"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btn_refresh"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="6dp"
        android:padding="6dp"
        android:text="@string/pairing_refresh"
        android:textColor="@color/scene_hint"
        android:textSize="12.5sp" />

    <!-- 配对进行中（25 屏简化态） -->
    <LinearLayout
        android:id="@+id/ll_pairing_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_btn_ghost"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_partner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/scene_text"
            android:textSize="13.5sp"
            android:textStyle="bold"
            tools:text="生育搭档：花卷 · 蠃虫 · Lv.28" />

        <TextView
            android:id="@+id/tv_pairing_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/scene_hint"
            android:textSize="12sp"
            tools:text="冷却还剩 2 天 · 后代名额 2/3" />

        <TextView
            android:id="@+id/btn_breed"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_btn_primary"
            android:gravity="center"
            android:text="@string/pairing_breed_now"
            android:textColor="@android:color/white"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_release"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:paddingVertical="4dp"
            android:text="@string/pairing_release"
            android:textColor="@color/scene_hint"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/pairing_footer"
        android:textColor="@color/scene_hint"
        android:textSize="11.5sp" />
</LinearLayout>
