<?xml version="1.0" encoding="utf-8"?>
<!-- 场景角落的蛋：蛋体 + 状态标签（免费领盲盒 / 孵化中 / 可破壳） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/iv_egg"
        android:layout_width="@dimen/scene_egg_size"
        android:layout_height="@dimen/scene_egg_size"
        android:contentDescription="@string/blind_box_title"
        tools:src="@drawable/pet_egg_common" />

    <TextView
        android:id="@+id/tv_egg_tag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/bg_chip_white"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:textColor="@color/scene_text"
        android:textSize="10.5sp"
        android:textStyle="bold"
        tools:text="免费领盲盒" />
</LinearLayout>
