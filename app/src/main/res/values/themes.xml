<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- 基础主题（Material3） -->
    <style name="Theme.SproutPet" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="android:colorBackground">@color/bg_page</item>
        <!-- 冷启动首帧与场景同色（docs/02 §10.1）：近白的 bg_page 会闪一下 -->
        <item name="android:windowBackground">@drawable/bg_launch_day</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <!-- 启动页主题 -->
    <style name="Theme.SproutPet.Splash" parent="Theme.SproutPet">
        <item name="android:windowBackground">@drawable/bg_launch_day</item>
    </style>

    <!--
      冷启动分流主题（docs/02 §10.1 · 2026-10-22 修「进程序闪一下」）：
      MainActivity 在 super.onCreate 之前按真实时间 setTheme，
      夜间启动用深色 windowBackground —— 两个主题只差这一层背景，其余继承基础主题。
    -->
    <style name="Theme.SproutPet.LaunchDay" parent="Theme.SproutPet" />

    <style name="Theme.SproutPet.LaunchNight" parent="Theme.SproutPet">
        <item name="android:windowBackground">@drawable/bg_launch_night</item>
    </style>

    <!-- 通用文本样式 -->
    <style name="TextTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextBody" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.4</item>
    </style>

    <style name="TextCaption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_hint</item>
    </style>

    <!-- 卡片 -->
    <style name="CardContainer">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">16dp</item>
    </style>

    <!-- 揭晓卡属性 kv chip（见 design-v2 .kv span） -->
    <style name="RevealKv">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">7dp</item>
        <item name="android:background">@drawable/bg_kv_chip</item>
        <item name="android:paddingHorizontal">10dp</item>
        <item name="android:paddingVertical">5dp</item>
        <item name="android:textColor">@color/scene_sub</item>
        <item name="android:textSize">11.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- 孵化抽层条目（见 design-v2 .srow） -->
    <style name="SheetRowTitle">
        <item name="android:textColor">@color/scene_text</item>
        <item name="android:textSize">13.5sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SheetRowDesc">
        <item name="android:textColor">@color/scene_hint</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- 抽屉分组标题（见 design-v2 .dtitle） -->
    <style name="DrawerSection">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">14dp</item>
        <item name="android:layout_marginBottom">2dp</item>
        <item name="android:textColor">@color/scene_hint</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.18</item>
    </style>

</resources>
